{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "build"
  },
  "include": ["src"],
  "exclude": ["**/__tests__/*"]
}
